{
  "name": "jarvis-knowledge-interface",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first personal knowledge interface for Notion, semantic graph exploration, and focused daily context.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sissighn/jarvis-knowledge-interface.git"
  },
  "keywords": [
    "notion",
    "knowledge-graph",
    "local-first",
    "personal-knowledge-management",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build && node --test tests/integration/rendered-html.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "type": "module",
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
