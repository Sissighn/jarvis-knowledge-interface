# Copy this file to .env.local. Never paste your token into the browser or source code.
NOTION_ACCESS_TOKEN=secret_your_internal_notion_token
NOTION_MAX_PAGES=80
NOTION_CONTENT_SCAN_LIMIT=40

# Optional weather location. Defaults to Berlin when these values are omitted.
WEATHER_LOCATION_NAME=Berlin
WEATHER_LATITUDE=52.52
WEATHER_LONGITUDE=13.405

# Optional local answer model. Ollama must be running on this Mac.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# Optional local speech-to-text server powered by whisper.cpp.
WHISPER_BASE_URL=http://127.0.0.1:8178
WHISPER_PORT=8178
WHISPER_MODEL_PATH=models/whisper/ggml-large-v3-turbo-q5_0.bin
WHISPER_LANGUAGE=de
