# Copy this file to .env.local. Never paste your token into the browser or source code.
NOTION_ACCESS_TOKEN=secret_your_internal_notion_token
NOTION_GLOSSARY_PAGE_ID=your_notion_glossary_page_id
NOTION_GLOSSARY_TABLE_BLOCK_ID=your_notion_table_block_id

# Optional weather location. Defaults to Berlin when these values are omitted.
WEATHER_LOCATION_NAME=Berlin
WEATHER_LATITUDE=52.52
WEATHER_LONGITUDE=13.405

# Local knowledge index. The indexer runs as its own localhost process during
# `npm run dev`; the desktop app answers /api/knowledge/* in its own Node server.
JARVIS_INDEXER_URL=http://127.0.0.1:4318
JARVIS_INDEXER_PORT=4318

# Optional local answer and embedding models. Ollama must be running on this Mac.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Optional local speech-to-text server powered by whisper.cpp.
WHISPER_BASE_URL=http://127.0.0.1:8178
WHISPER_PORT=8178
WHISPER_MODEL_PATH=models/whisper/ggml-large-v3-turbo-q5_0.bin
WHISPER_LANGUAGE=de

# Voice assistant. Tool calling can use a different model than grounded knowledge
# answers; the model has to support tools in Ollama.
OLLAMA_ASSISTANT_MODEL=qwen3.5:4b

# Spotify playback control. Create an app in the Spotify Developer Dashboard and add
# http://127.0.0.1:4319/callback as redirect URI. PKCE needs no client secret.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_REDIRECT_PORT=4319

# Google Calendar and Gmail. Create an OAuth client of type "Desktop app" in the Google Cloud
# console. The assistant may read mail and read or create calendar events; it can never send,
# write, or delete a message, because no such scope is ever requested.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_PORT=4320

# Time zone for spoken times and for new calendar events. Defaults to Europe/Berlin.
JARVIS_TIME_ZONE=Europe/Berlin

# Optional extra programs the assistant may launch by voice, comma separated.
JARVIS_ALLOWED_APPS=Figma,Slack
