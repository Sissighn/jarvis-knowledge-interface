{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JARVIS",
  "version": "0.1.0",
  "identifier": "com.sissighn.jarvis",
  "build": {
    "frontendDist": "../desktop/loader",
    "devUrl": "http://127.0.0.1:4317",
    "beforeDevCommand": "npm run desktop:web",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JARVIS",
        "width": 1440,
        "height": 900,
        "minWidth": 780,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "backgroundColor": "#090508"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local-first personal knowledge interface",
    "longDescription": "A private macOS interface for Notion knowledge, local AI answers, voice input, weather, and focused technology briefings.",
    "externalBin": ["binaries/jarvis-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
